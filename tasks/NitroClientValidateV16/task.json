{
  "$schema": "https://raw.githubusercontent.com/Microsoft/azure-pipelines-task-lib/master/tasks.schema.json",
  "id": "8e7d18ee-ca97-445e-9ae8-d197d957976d",
  "name": "NitroClientValidate",
  "friendlyName": "Nitro Client Validate",
  "description": "Validates client operations against the Nitro registry.",
