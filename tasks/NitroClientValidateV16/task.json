    },
    {
      "name": "operationsFile",
      "type": "filePath",
      "label": "Operations file",
      "required": true,
      "helpMarkDown": "Path to the JSON file with the operations."
    },
    {
      "name": "cloudUrl",
      "type": "string",
      "label": "Cloud URL",
      "required": false,
      "helpMarkDown": "The URL of the Nitro registry."
    }
