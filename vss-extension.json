{
  "manifestVersion": 1,
  "id": "nitro-azure-pipelines-tasks",
  "name": "Nitro for Azure Pipelines",
  "version": "1.0.14",
  "publisher": "ChilliCream",
  "description": "Publish, upload, and validate GraphQL schemas, Fusion configurations, clients, OpenAPI and MCP Feature collections using Nitro.",
  "public": true,
  "targets": [
    {
      "id": "Microsoft.VisualStudio.Services"
    }
  ],
  "categories": [
    "Azure Pipelines"
  ],
  "tags": [
    "graphql",
    "nitro",
    "chillicream",
    "hotchocolate",
    "fusion"
  ],
  "scopes": [],
  "icons": {
    "default": "images/extension-icon.png"
  },
  "content": {
    "details": {
      "path": "README.md"
    }
  },
  "links": {
    "home": {
      "uri": "https://chillicream.com/products/nitro"
    },
    "repository": {
      "uri": "https://github.com/ChilliCream/nitro-azure-pipelines-tasks"
    },
    "issues": {
      "uri": "https://github.com/ChilliCream/nitro-azure-pipelines-tasks/issues"
    },
    "license": {
      "uri": "https://github.com/ChilliCream/nitro-azure-pipelines-tasks/blob/main/LICENSE"
    }
  },
  "repository": {
    "type": "git",
    "uri": "https://github.com/ChilliCream/nitro-azure-pipelines-tasks"
  },
  "files": [
    {
      "path": "tasks/NitroClientPublishV16"
    },
    {
      "path": "tasks/NitroClientUploadV16"
    },
    {
      "path": "tasks/NitroClientValidateV16"
    },
    {
      "path": "tasks/NitroFusionPublishV16"
    },
    {
      "path": "tasks/NitroFusionUploadV16"
    },
    {
      "path": "tasks/NitroFusionValidateV16"
    },
    {
      "path": "tasks/NitroMcpPublishV16"
    },
    {
      "path": "tasks/NitroMcpUploadV16"
    },
    {
      "path": "tasks/NitroMcpValidateV16"
    },
    {
      "path": "tasks/NitroOpenApiPublishV16"
    },
    {
      "path": "tasks/NitroOpenApiUploadV16"
    },
    {
      "path": "tasks/NitroOpenApiValidateV16"
