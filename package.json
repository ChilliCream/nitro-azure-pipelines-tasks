{
  "name": "@chillicream/nitro-azure-pipelines-tasks",
  "version": "1.0.2",
  "private": true,
  "type": "module",
  "description": "Azure Pipelines tasks for the Nitro CLI.",
  "license": "MIT",
  "author": "ChilliCream",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ChilliCream/nitro-azure-pipelines-tasks.git"
  },
  "workspaces": [
    "shared/*",
    "tasks/*"
  ],
  "scripts": {
