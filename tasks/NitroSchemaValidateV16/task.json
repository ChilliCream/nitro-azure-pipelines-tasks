{
  "$schema": "https://raw.githubusercontent.com/Microsoft/azure-pipelines-task-lib/master/tasks.schema.json",
  "id": "e8eb619c-a3bd-4d6b-8c3b-817c59b6c4f0",
  "name": "NitroSchemaValidate",
  "friendlyName": "Nitro Schema Validate",
  "description": "Validates a GraphQL schema against the Nitro registry.",
  "helpUrl": "https://chillicream.com/docs/nitro",
  "helpMarkDown": "[Documentation](https://chillicream.com/docs/nitro)",
  "category": "Test",
  "author": "ChilliCream",
  "version": {
    "Major": 16,
    "Minor": 0,
    "Patch": 0
  },
  "instanceNameFormat": "Nitro Schema Validate: $(stage)",
  "execution": {
    "Node20_1": {
      "target": "dist/index.js"
    }
  },
  "inputs": [
    {
      "name": "stage",
      "type": "string",
      "label": "Stage",
      "required": true,
      "helpMarkDown": "The name of the stage."
    },
    {
      "name": "apiId",
      "type": "string",
      "label": "API ID",
      "required": true,
      "helpMarkDown": "The ID of the API."
    },
    {
      "name": "schemaFile",
      "type": "filePath",
      "label": "Schema file",
      "required": true,
      "helpMarkDown": "Path to the schema file."
    },
    {
      "name": "apiKey",
      "type": "string",
      "label": "API key",
      "required": true,
      "helpMarkDown": "API key for authentication. Use a secret pipeline variable: `$(NITRO_API_KEY)`."
    },
    {
      "name": "cloudUrl",
      "type": "string",
      "label": "Cloud URL",
      "required": false,
      "helpMarkDown": "The URL of the Nitro registry."
    }
  ]
}
