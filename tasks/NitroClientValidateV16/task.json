  "helpMarkDown": "[Documentation](https://chillicream.com/docs/nitro)",
  "category": "Test",
  "author": "ChilliCream",
  "version": {
    "Major": 16,
    "Minor": 0,
    "Patch": 0
  },
  "instanceNameFormat": "Nitro Client Validate: $(stage)",
